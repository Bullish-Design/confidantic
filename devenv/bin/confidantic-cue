#!/usr/bin/env bash
# confidantic-cue — stable wrapper around cue (+ jq when needed)
#
# Normalizes argument style across recipes, applies shape transforms
# before vet when required, and enforces consistent flags and schema
# path handling.
#
# Usage:
#   confidantic-cue vet <data.json> <schema-dir-or-files...> [--expression EXPR]
#   confidantic-cue fmt <cue-files...>
#   confidantic-cue vet-jsonl <data.jsonl> <schema-dir-or-files...> [--expression EXPR] [--jq-transform FILTER]

set -euo pipefail

readonly PROG="confidantic-cue"

die() {
    echo "${PROG}: error: $*" >&2
    exit 1
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

# Ensure required tools are available
require_cmd cue
require_cmd jq

cmd_vet() {
    local data_file="$1"
    shift

    local schemas=()
    local expression=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --expression|-d)
                expression="$2"
                shift 2
                ;;
            *)
                schemas+=("$1")
                shift
                ;;
        esac
    done

    [[ -f "$data_file" ]] || die "data file not found: $data_file"
    [[ ${#schemas[@]} -gt 0 ]] || die "no schema files specified"

    local cmd=(cue vet)
    for s in "${schemas[@]}"; do
        cmd+=("$s")
    done
    cmd+=("$data_file")

    if [[ -n "$expression" ]]; then
        cmd+=(-d "$expression")
    fi

    "${cmd[@]}"
}

cmd_fmt() {
    [[ $# -gt 0 ]] || die "no files specified for formatting"

    for f in "$@"; do
        [[ -f "$f" ]] || die "file not found: $f"
        cue fmt "$f"
    done
}

cmd_vet_jsonl() {
    local jsonl_file="$1"
    shift

    local schemas=()
    local expression=""
    local jq_transform=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --expression|-d)
                expression="$2"
                shift 2
                ;;
            --jq-transform)
                jq_transform="$2"
                shift 2
                ;;
            *)
                schemas+=("$1")
                shift
                ;;
        esac
    done

    [[ -f "$jsonl_file" ]] || die "JSONL file not found: $jsonl_file"
    [[ ${#schemas[@]} -gt 0 ]] || die "no schema files specified"

    local line_num=0
    local errors=0

    while IFS= read -r line || [[ -n "$line" ]]; do
        line_num=$((line_num + 1))

        # Skip empty lines
        [[ -z "${line// /}" ]] && continue

        # Validate JSON syntax
        if ! echo "$line" | jq empty 2>/dev/null; then
            echo "${PROG}: line ${line_num}: invalid JSON" >&2
            errors=$((errors + 1))
            continue
        fi

        # Apply jq transform if specified
        local record="$line"
        if [[ -n "$jq_transform" ]]; then
            record=$(echo "$line" | jq "$jq_transform" 2>/dev/null) || {
                echo "${PROG}: line ${line_num}: jq transform failed" >&2
                errors=$((errors + 1))
                continue
            }
        fi

        # Write to temp file and vet
        local tmp
        tmp=$(mktemp --suffix=.json)
        echo "$record" > "$tmp"

        local vet_cmd=(cue vet)
        for s in "${schemas[@]}"; do
            vet_cmd+=("$s")
        done
        vet_cmd+=("$tmp")
        if [[ -n "$expression" ]]; then
            vet_cmd+=(-d "$expression")
        fi

        if ! "${vet_cmd[@]}" 2>/dev/null; then
            echo "${PROG}: line ${line_num}: validation failed" >&2
            errors=$((errors + 1))
        fi

        rm -f "$tmp"

    done < "$jsonl_file"

    if [[ $errors -gt 0 ]]; then
        echo "${PROG}: ${errors} line(s) failed validation" >&2
        exit 1
    fi
}

# Main dispatch
case "${1:-}" in
    vet)
        shift
        cmd_vet "$@"
        ;;
    fmt)
        shift
        cmd_fmt "$@"
        ;;
    vet-jsonl)
        shift
        cmd_vet_jsonl "$@"
        ;;
    -h|--help|"")
        echo "Usage: ${PROG} <command> [args...]"
        echo ""
        echo "Commands:"
        echo "  vet        Validate JSON data against CUE schema(s)"
        echo "  fmt        Format CUE files"
        echo "  vet-jsonl  Validate JSONL records against CUE schema(s)"
        echo ""
        echo "Run '${PROG} <command> --help' for command-specific help."
        ;;
    *)
        die "unknown command: $1"
        ;;
esac
